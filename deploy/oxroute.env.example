# oxroute configuration. Copy to ~/.config/oxroute/env and fill in.
#
# The Slack bot's own variable names are accepted as fallbacks everywhere
# they existed, so an existing ~/.config/codex-slack/env can be used as-is
# for a first run and renamed later.

# -- required ----------------------------------------------------------

# The Slack user id allowed to drive this. There is no multi-user mode: it
# runs commands on a machine you own.
# (SLACK_ALLOWED_USER_ID is read as a fallback.)
OXROUTE_OWNER=U00000000

# -- slack -------------------------------------------------------------
# From the app created with deploy/slack-manifest.json. The app token needs
# connections:write. Leave both unset to run with no sources, which is
# useful for trying the UI.
# (SLACK_APP_TOKEN / SLACK_BOT_TOKEN are read as fallbacks.)
OXROUTE_SLACK_APP_TOKEN=xapp-...
OXROUTE_SLACK_BOT_TOKEN=xoxb-...

# -- harnesses ---------------------------------------------------------

# Where agents run.
# (CODEX_SLACK_WORKSPACE is read as a fallback.)
#OXROUTE_WORKSPACE=%h

# (CODEX_CLI is read as a fallback.)
#OXROUTE_CODEX_CLI=%h/.local/bin/codex
#OXROUTE_CLAUDE_CLI=claude

# The separately supervised Codex app-server. Keep it on loopback.
#OXROUTE_CODEX_URL=ws://127.0.0.1:8788

#OXROUTE_CODEX_EFFORT=medium
#OXROUTE_TITLE_MODEL=gpt-5.6-luna

# Models a person can pick by typing the alias. `alias=id:Label`, comma
# separated. An id beginning with `claude` runs on the Claude Code harness;
# anything else runs on Codex.
#OXROUTE_MODELS=sol=gpt-6-sol:Sol,astra=gpt-6-astra:Astra,opus=claude-opus-5:Opus,sonnet=claude-sonnet-5:Sonnet
#OXROUTE_DEFAULT_MODEL=gpt-6-sol

# -- paths -------------------------------------------------------------
#OXROUTE_DATABASE=%h/.local/state/oxroute/oxroute.sqlite3
#OXROUTE_ATTACHMENTS=%h/.local/share/oxroute/attachments
#OXROUTE_ARTIFACTS=%h/.local/share/oxroute/artifacts

# Where to find the Slack bot's database to import. Usually found without
# help; set it if yours is somewhere unusual.
#CODEX_SLACK_DATABASE=%h/.local/share/codex-slack/state/threads.sqlite3

# -- behaviour ---------------------------------------------------------

# Silence for this long means something is wrong. Seconds.
#OXROUTE_STALL_TIMEOUT=600

# Refuse new work below this much free disk, rather than running out of
# space halfway through a write.
#OXROUTE_MIN_FREE_BYTES=536870912

# The daemon binds here. Keep it on localhost: there is no authentication,
# because anything that can reach it can run commands as you.
#OXROUTE_LISTEN=127.0.0.1:8787

#OXROUTE_LOG=info
